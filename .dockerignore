# =============================================================
#  .dockerignore – keeps Docker build contexts lean
#  Applies to both Backend/ and frontend/ build contexts
# =============================================================

# Dependencies – reinstalled inside the image
**/node_modules
**/.pnp
**/.pnp.js

# Build artefacts
**/.next
**/dist
**/build
**/out

# Environment files – NEVER bake secrets into images
**/.env
**/.env.local
**/.env.development
**/.env.production
!**/.env.example

# Editor / OS noise
**/.git
**/.gitignore
**/.DS_Store
**/Thumbs.db
**/.vscode
**/.idea

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/*.log

# Tests
**/__tests__
**/*.test.ts
**/*.spec.ts
**/coverage

# TypeScript incremental build info (large, not needed)
**/*.tsbuildinfo

# Docker files themselves (not needed inside containers)
**/Dockerfile*
**/docker-compose*
